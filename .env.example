# =============================================================================
# StudyAI — Safe Environment Variables Example Template (.env.example)
# =============================================================================
# Copy this file to .env and configure with your environment-specific values:
#   Windows:      copy .env.example .env
#   Linux/macOS:  cp .env.example .env
# NEVER commit your real .env file with real secrets to version control.
# =============================================================================

# =============================================================================
# 1. FRONTEND CONFIGURATION (Vite React)
# =============================================================================
# Backend API Base URL
# - Local dev same-machine: http://127.0.0.1:8000
# - LAN/WiFi dev:           http://<HOST_IP>:8000 (e.g. http://192.168.1.100:8000)
# - Production with proxy:  /api or https://api.yourdomain.com
VITE_API_BASE_URL=http://127.0.0.1:8000

# Frontend development host binding (0.0.0.0 allows LAN access; 127.0.0.1 is local-only)
VITE_HOST=127.0.0.1
VITE_PORT=5173

# Toggle local mock adapter (set to false to communicate with live Django backend)
VITE_USE_MOCKS=false


# =============================================================================
# 2. BACKEND CORE CONFIGURATION (Django)
# =============================================================================
# Development mode: True for local debugging; MUST be False in production
DJANGO_DEBUG=True

# Secret key: In development, an ephemeral key is generated if left empty.
# In PRODUCTION (DJANGO_DEBUG=False), this is MANDATORY and must be >= 50 characters.
DJANGO_SECRET_KEY=studyai-change-this-to-a-cryptographically-secure-random-key-for-prod

# Hostnames allowed to serve requests (comma-separated, without http://)
# In development: localhost,127.0.0.1
# In production:  studyai.yourdomain.com,api.yourdomain.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Allowed origins for Cross-Origin Resource Sharing (CORS)
# Include every frontend URL allowed to contact this backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Trusted origins for CSRF validation (defaults to CORS_ALLOWED_ORIGINS if unset)
# CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Reverse proxy IPs for client IP extraction (e.g. Nginx IP, 127.0.0.1)
DJANGO_TRUSTED_PROXIES=127.0.0.1,::1

# HTTPS / TLS enforcement flags (Enable in production behind HTTPS reverse proxy)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=31536000


# =============================================================================
# 3. AI PROVIDER & OLLAMA CONFIGURATION
# =============================================================================
# Select one server-side provider: ollama, openai, openai_compatible, gemini, or anthropic.
AI_PROVIDER=ollama
# Optional single fallback provider. Leave empty to disable fallback.
AI_FALLBACK_PROVIDER=
AI_MAX_TOKENS=3000
# Optional per-model USD rates per 1M tokens; unknown rates are not guessed.
AI_MODEL_PRICING_USD_PER_1M_JSON={}

# Base URL of the Ollama AI daemon
# - Native host:   http://localhost:11434
# - Docker bridge: http://host.docker.internal:11434
# - Remote host:   http://<AI_SERVER_IP>:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_HOST=http://localhost:11434

# Configured LLM model to use for grounded extraction, summaries, and exams
# Must match a model pulled in Ollama (e.g. ollama pull llama3:latest)
# Supported options: llama3:latest, mistral:latest, gemma:latest, phi3:latest
OLLAMA_MODEL=llama3:latest

# Cloud provider keys are optional and must remain server-side.
# When a cloud provider is selected, relevant document excerpts and prompts are sent to it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1


# =============================================================================
# 4. DATABASE & STORAGE CONFIGURATION
# =============================================================================
# Default: SQLite (portable, built-in, no external server required)
# Path defaults to backend/db.sqlite3

# Optional: Full Database URL (supports postgres:// or sqlite:///)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/studyai_db

# Optional: PostgreSQL direct configuration
USE_POSTGRES=False
DB_NAME=studyai_db
DB_USER=postgres
DB_PASSWORD=your_secure_database_password_placeholder
DB_HOST=localhost
DB_PORT=5432

# Media upload storage root (defaults to backend/media inside project root)
# MEDIA_ROOT=/path/to/persistent/media

# Document upload limit in bytes (defaults to 25MB: 26214400)
MAX_UPLOAD_SIZE_BYTES=26214400

# Optional Redis Cache URL for high-concurrency production deployments
# REDIS_URL=redis://127.0.0.1:6379/1


# =============================================================================
# 5. DOCUMENT OCR CONFIGURATION
# =============================================================================
# Path to Tesseract OCR executable (auto-discovered via PATH, registry, and standard paths if left unset):
# Windows example: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux example:   TESSERACT_CMD=/usr/bin/tesseract
# macOS example:   TESSERACT_CMD=/opt/homebrew/bin/tesseract
# TESSERACT_CMD=

# OCR recognition language(s) (plus-separated for multilingual: eng, eng+hin, fra, etc.)
OCR_LANGUAGES=eng

# Rendering resolution DPI for PDF-to-image rasterization (balanced default: 200, fast: 150, high-res: 300)
OCR_DPI=200

# Timeout per individual page OCR operation in seconds (prevents slow or corrupted pages from hanging)
OCR_TIMEOUT_PER_PAGE=25

# Maximum total timeout for processing all pages in a document (in seconds)
OCR_TOTAL_TIMEOUT=300

# Maximum pages allowed for OCR processing per document (prevents out-of-memory on massive books)
MAX_OCR_PAGES=100

# OCR processing quality mode: FAST, BALANCED, or HIGH_QUALITY
OCR_QUALITY_MODE=BALANCED

# Minimum average confidence score (0-100) before triggering preprocessing retry or warning
OCR_MIN_CONFIDENCE=50.0



# =============================================================================
# 6. EMAIL & OTP AUTHENTICATION CONFIGURATION
# =============================================================================
# Choose email delivery backend:
# - Local development default (when EMAIL_HOST_USER is unset):
#     django.core.mail.backends.console.EmailBackend (OTP codes print to server terminal)
# - Production with real SMTP:
#     django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP Server Settings (Required for production email verification)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# SMTP Credentials (For Gmail, generate a 16-character App Password at myaccount.google.com/apppasswords)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Sender address shown to students in verification emails
DEFAULT_FROM_EMAIL=StudyAI Security <no-reply@studyai.edu>
EMAIL_TIMEOUT=15

# Authentication security timings
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_TOKEN_EXPIRY_DAYS=7
